rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Per-user document: only the owner can read/write,
    // and only the expected top-level fields and tool keys are accepted.
    // Profile fields (displayName + serverNumber) power the community comments.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
              'tools', 'lastUpdated', 'displayName', 'serverNumber', 'updatedAt'
            ])
        && (!('lastUpdated' in request.resource.data) ||
            request.resource.data.lastUpdated is string)
        && (!('displayName' in request.resource.data) ||
            (request.resource.data.displayName is string
              && request.resource.data.displayName.size() >= 2
              && request.resource.data.displayName.size() <= 24))
        && (!('serverNumber' in request.resource.data) ||
            (request.resource.data.serverNumber is int
              && request.resource.data.serverNumber >= 1
              && request.resource.data.serverNumber <= 99999))
        && (!('updatedAt' in request.resource.data) ||
            request.resource.data.updatedAt is string)
        && (!('tools' in request.resource.data) ||
            request.resource.data.tools.keys().hasOnly([
              'gvg',
              'buildTime',
              'combatCraft',
              'championUpgrade',
              'nexus'
            ]));
    }

    // Community comments on news articles and guides.
    // Read is public; create is validated server-side; users can only delete
    // their own comments. Comments are immutable once created.
    match /comments/{docId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
              'content', 'authorUid', 'displayName', 'serverNumber', 'type', 'itemId', 'createdAt'
            ])
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 1
        && request.resource.data.content.size() <= 2000
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 24
        && request.resource.data.serverNumber is int
        && request.resource.data.serverNumber >= 1
        && request.resource.data.serverNumber <= 99999
        && (request.resource.data.type == 'news' || request.resource.data.type == 'guide' || request.resource.data.type == 'event')
        && request.resource.data.itemId is string
        && request.resource.data.itemId.size() >= 1
        && request.resource.data.itemId.size() <= 64
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.authorUid == request.auth.uid;
    }

    // Stella Anomaly event submissions (public leaderboard).
    // Create is validated server-side; submissions are immutable.
    match /stella_anomaly_submissions/{docId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly([
            'gameUid', 'secretCode', 'firebaseUid', 'lang', 'submittedAt', 'rank'
          ])
        && request.resource.data.gameUid is string
        && request.resource.data.gameUid.size() > 0
        && request.resource.data.gameUid.size() <= 30
        && request.resource.data.gameUid.matches('^[0-9]+$')
        && request.resource.data.secretCode is string
        && request.resource.data.secretCode.size() > 0
        && (request.resource.data.firebaseUid == null ||
            request.resource.data.firebaseUid is string)
        && request.resource.data.lang is string
        && request.resource.data.submittedAt is string
        && request.resource.data.rank is int
        && request.resource.data.rank >= 1;
      allow update, delete: if false;
    }

    // Atomic rank counter for the Stella Anomaly leaderboard.
    // It can only ever be incremented by exactly 1 (transactions only).
    match /stella_anomaly_meta/{metaId} {
      allow read: if true;
      allow create: if metaId == 'counter'
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if metaId == 'counter'
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is int
        && resource.data.count is int
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && (request.auth.token.email == 'fgfwiwi@gmail.com' || request.auth.token.email == 'vieira.andre@proton.me');
    }

    // Game Evolutions & Feature Requests.
    // Public read; authenticated users can propose and vote; admin/author can moderate.
    match /evolutions/{evolutionId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 5;
      allow update: if request.auth != null
        && (
          isAdmin()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'votesCount', 'commentCount'])
        );
      allow delete: if request.auth != null
        && (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    // Discussion comments on evolution threads.
    match /evolution_comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 1
        && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false || isAdmin());
      allow update: if false;
      allow delete: if request.auth != null
        && (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    // Default deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
